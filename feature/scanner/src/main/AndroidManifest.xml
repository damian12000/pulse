<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Scanning is a core feature, but the app stays fully usable without a
         camera: search, manual entry and everything else still work. Marking it
         not-required keeps the app installable on devices without one. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application>
        <!-- Fetch the barcode model at install time so the first scan isn't a wait. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode" />
    </application>

</manifest>
